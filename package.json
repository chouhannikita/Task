{
  "name": "taskly",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm --workspace backend run dev\" \"npm --workspace frontend run dev\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "preview": "npm --workspace frontend run preview",
    "test": "npm --workspace backend run test",
    "test:integration": "npm --workspace backend run test:integration"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
